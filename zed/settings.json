{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "model": ["claude-fable-5"]
      },
      "default_config_options": {
        "fast": true,
        "mode": "bypassPermissions",
        "model": "opus[1m]",
        "effort": "default"
      },
      "type": "registry"
    }
  },
  "git_panel": {
    "dock": "left",
    "collapse_untracked_diff": false
  },
  "edit_predictions": {
    "provider": "none"
  },
  "disable_ai": false,
  "format_on_save": "on",
  "tab_size": 2,
  "agent": {
    "auto_compact": {
      "threshold": "90%"
    },
    "sandbox_permissions": {
      "network_hosts": [
        "modest-ui.com",
        "registry.npmjs.org",
        "cdn.jsdelivr.net",
        "developer.mozilla.org",
        "questbar.app"
      ]
    },
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "copy_path": {
          "default": "allow"
        },
        "write_file": {
          "default": "allow"
        },
        "move_path": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^git\\s+log(\\s|$)"
            },
            {
              "pattern": "^cd\\s+ui/migrate\\-info\\-button(\\s|$)"
            },
            {
              "pattern": "^git\\s+status(\\s|$)"
            },
            {
              "pattern": "^cd\\s+ui/migrate\\-toast/apps/ffern\\.co(\\s|$)"
            },
            {
              "pattern": "^sed\\b"
            },
            {
              "pattern": "^cd\\s+main(\\s|$)"
            },
            {
              "pattern": "^gh\\s+pr(\\s|$)"
            },
            {
              "pattern": "^cd\\s+ui/migrate\\-page\\-header(\\s|$)"
            },
            {
              "pattern": "^head\\b"
            }
          ]
        }
      }
    },
    "dock": "right",
    "expand_terminal_card": true,
    "default_model": { "enable_thinking": false, "provider": "llama.cpp", "model": "Local Coder" },
    "model_parameters": []
  },
  "language_models": {
    "llama.cpp": {
      "api_url": "http://localhost:1337",
      "auto_discover": false,
      "available_models": [
        {
          "name": "Local Coder",
          "max_tokens": 32768,
          "supports_tools": true,
          "supports_images": false
        }
      ]
    }
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "!eslint", "..."]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "!eslint", "..."]
    },
    "JavaScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "!eslint", "..."]
    },
    "JSX": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "!eslint", "..."]
    }
  },
  "diff_view_style": "split",
  "preferred_line_length": 140,
  "soft_wrap": "bounded",
  "telemetry": { "diagnostics": false, "metrics": false },
  "vim_mode": true,
  "vim": { "cursor_shape": { "normal": "hollow", "replace": "underline", "visual": "block" } },
  "relative_line_numbers": "enabled",
  "ui_font_size": 13,
  "buffer_font_size": 12,
  "theme": "Synthwave84 High Contrast",
  "prettier": { "trailingComma": "none" },
  "context_servers": {
    "brandwatch-social": {
      "command": "node",
      "args": ["/Users/marcusmichaels/Desktop/brandwatch-mcp/dist/servers/social.js"]
    },
    "brandwatch-team": {
      "command": "node",
      "args": ["/Users/marcusmichaels/Desktop/brandwatch-mcp/dist/servers/team.js"]
    },
    "MCP_DOCKER": {
      "enabled": false,
      "command": "docker",
      "args": ["mcp", "gateway", "run"]
    }
  },
  "context_server_timeout": 600,
  "experimental.theme_overrides": {
    // "search.match_background": "#ff00f090",
    // "warning.background": "#FF00FF20",
  }
}
